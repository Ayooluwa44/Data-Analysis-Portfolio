/*20. Return the monthly total SalesAmount for the year 2013 using DimDate.*/
SELECT 
    DD.CalendarYear,
    DD.MonthNumberOfYear,
    DD.EnglishMonthName,
    SUM(FIS.SalesAmount) AS Total_Sales
FROM FactInternetSales FIS
INNER JOIN DimDate DD
    ON FIS.OrderDateKey = DD.DateKey
WHERE 
    DD.CalendarYear = 2013
GROUP BY 
    DD.CalendarYear,
    DD.MonthNumberOfYear,
    DD.EnglishMonthName
ORDER BY 
    DD.MonthNumberOfYear;

