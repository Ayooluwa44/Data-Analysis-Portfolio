/*21. List each product's name, subcategory, and category by
joining DimProduct, DimProductSubcategory, and DimProductCategory.*/
SELECT 
    DP.EnglishProductName AS ProductName,
    DPS.EnglishProductSubcategoryName AS Subcategory,
    DPC.EnglishProductCategoryName AS Category
FROM DimProduct DP
LEFT JOIN DimProductSubcategory DPS
    ON DP.ProductSubcategoryKey = DPS.ProductSubcategoryKey
LEFT JOIN DimProductCategory DPC
    ON DPS.ProductCategoryKey = DPC.ProductCategoryKey
ORDER BY 
    Category, Subcategory, ProductName;

/*22. Find all customers who have never placed an internet order.
Use DimCustomer and FactInternetSales.*/
SELECT 
    DC.CustomerKey,
    DC.FirstName,
    DC.LastName
FROM DimCustomer DC
WHERE NOT EXISTS (
    SELECT 1
    FROM FactInternetSales FIS
    WHERE FIS.CustomerKey = DC.CustomerKey
);
